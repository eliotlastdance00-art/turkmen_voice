# Türkmen Ses API — nusga:  cp .env.example .env
DATA_DIR=app/data

# Admin panel / admin API üçin token (boş goýsaňyz açyk režim bolýar — diňe lokal!)
# PRODUKSIYONDA HÖKMAN DOLDUR! Uzyn, howpsuz parol ulanyň: openssl rand -hex 16
ADMIN_TOKEN=

# CORS: "*" ýa-da "https://admin.example.com,https://example.com"
# PRODUKSIYONDA DIŇE ÖZ DOMENIŇIZI GOÝ!
CORS_ORIGINS=*

# Eksportda audio URL-i üçin (deploy edilenden soň dolduryň),
# mysal: https://turkmen-ses-api.onrender.com
PUBLIC_BASE_URL=

# Whisper formaty
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1
TARGET_BIT_DEPTH=16
MIN_DURATION_MS=500
MAX_DURATION_MS=15000
MAX_AUDIO_BYTES=10485760
MIN_RMS_DBFS=-50

# Jemgyýetçilik bahalary
AUTO_APPROVE_MIN_RATINGS=3
AUTO_APPROVE_MIN_SCORE=4.0
RATINGS_DAILY_LIMIT=400

# Production worker sany (Docker da ulanylýar)
WEB_CONCURRENCY=2
