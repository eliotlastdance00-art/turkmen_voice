# Türkmen Ses API — nusga:  cp .env.example .env
#
# FastAPI Cloud-da bu faýl ulanylmaýar: üýtgeýjiler dashboard → App → Settings →
# Environment bölüminde (ýa-da `fastapi cloud env set`) goýulýar. Doly gollanma:
# ../docs/DEPLOYMENT.md

DATA_DIR=app/data

# Admin panel / admin API üçin token (boş goýsaňyz açyk režim bolýar — diňe lokal!).
# PRODUKSIYONDA HÖKMAN DOLDUR! Uzyn, howpsuz parol ulanyň: openssl rand -hex 16
ADMIN_TOKEN=

# CORS: "*" ýa-da "https://admin.example.com,https://example.com"
# PRODUKSIYONDA DIŇE ÖZ DOMENIŇIZI GOÝ!
CORS_ORIGINS=*

# Eksportdaky audio URL-leri üçin (deploy edilenden soňky doly URL):
# FastAPI Cloud mysaly: https://turkmen-voice-09885e66.fastapicloud.dev
PUBLIC_BASE_URL=

# Goşmaça rugsat berilýän Host-lar (PUBLIC_BASE_URL-dan başga).
# localhost / 127.0.0.1 elmydama rugsat berilýär (içerki health probe üçin).
ALLOWED_HOSTS=

# Whisper formaty
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1
TARGET_BIT_DEPTH=16
MIN_DURATION_MS=500
MAX_DURATION_MS=15000
MAX_AUDIO_BYTES=10485760
MIN_RMS_DBFS=-50

# Jemgyýetçilik bahalary
AUTO_APPROVE_MIN_RATINGS=3
AUTO_APPROVE_MIN_SCORE=4.0
RATINGS_DAILY_LIMIT=400

# Docker/VPS: gunicorn işçi sany we port
WEB_CONCURRENCY=2
PORT=8000
