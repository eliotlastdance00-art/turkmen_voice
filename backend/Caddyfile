# API_DOMAIN=.env faýlynda doldurylýar (mysal: api.turkmen-ses.tm).
# Domen ýok bolsa "localhost" bilen lokal HTTPS işleýär.
{$API_DOMAIN} {
	encode gzip zstd

	# admin panel + swagger açylmagy üçin
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /admin* {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}
	handle {
		respond "Türkmen Ses API" 200
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
